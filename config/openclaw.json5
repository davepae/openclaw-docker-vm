// OpenClaw gateway config for the openclaw VM. JSON5.
// Mounted READ-ONLY into the gateway (OPENCLAW_CONFIG_READONLY=1): the agent
// cannot change its own policy. Edit here, commit, git pull on the VM, then
// `docker compose up -d --force-recreate openclaw-gateway`.
//
// ${VARS} come from compose/.env on the VM (never committed).
{
  gateway: {
    mode: "local",
    bind: "lan", // inside the container; Compose publishes it on host 127.0.0.1 only
    port: 18789,
    auth: { mode: "token", token: "${OPENCLAW_GATEWAY_TOKEN}" },
    controlUi: {
      allowedOrigins: ["http://127.0.0.1:18789", "http://localhost:18789"],
    },
  },

  models: {
    mode: "merge",
    providers: {
      strata: {
        baseUrl: "http://llm.paelab.com:8080/v1",
        apiKey: "${STRATA_API_KEY}",
        api: "openai-completions",
        timeoutSeconds: 300, // local model; long first-token times are normal
        models: [
          {
            id: "qwen3.8-flash-next-iq2_xs",
            name: "Qwen3.8 Flash Next IQ2_XS (Strata)",
            reasoning: false,
            input: ["text", "image"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            // Strata runs 131072 context with 2 parallel slots. If it splits
            // context per slot, lower this to 65536.
            contextWindow: 131072,
            maxTokens: 8192,
          },
        ],
      },
    },
  },

  agents: {
    defaults: {
      // Host path, mounted at the same path in the gateway (sibling sandboxes
      // are created by the host's Docker daemon, which resolves host paths).
      workspace: "/srv/openclaw/workspace",
      model: { primary: "strata/qwen3.8-flash-next-iq2_xs" },
      // Phase 3 switches this to mode "all" once the sandbox image exists.
      sandbox: { mode: "off" },
    },
  },

  tools: {
    // Exec may only ever run in a sandbox. Until Phase 3 there is no sandbox,
    // so exec is unavailable. Host (gateway) exec is denied outright.
    exec: { host: "sandbox", mode: "deny" },
    // No escape hatch out of the sandbox.
    elevated: { enabled: false },
  },
}
