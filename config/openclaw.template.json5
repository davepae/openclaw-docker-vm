// OpenClaw gateway config TEMPLATE. JSON5.
// compose/install.sh renders it into config/generated/openclaw.json5, filling
// each placeholder from site.env (see ./configure.sh), and mounts the
// result READ-ONLY into the gateway (OPENCLAW_CONFIG_READONLY=1): the agent
// cannot change its own policy. Edit here, then re-run ./compose/install.sh.
//
// ${VARS} are resolved by OpenClaw from the gateway's environment at runtime,
// so secrets never land in the rendered file: OPENCLAW_GATEWAY_TOKEN and
// FIRECRAWL_API_KEY come from compose/.env, LLM_API_KEY from site.env.
{
  gateway: {
    mode: "local",
    bind: "lan", // inside the container; Compose publishes it on host 127.0.0.1 only
    port: 18789,
    auth: { mode: "token", token: "${OPENCLAW_GATEWAY_TOKEN}" },
    controlUi: {
      allowedOrigins: ["http://127.0.0.1:18789", "http://localhost:18789"],
    },
  },

  models: {
    mode: "merge",
    providers: {
      // Any OpenAI-compatible server: Strata, Ollama, LM Studio, vLLM, llama.cpp ...
      llm: {
        baseUrl: @@LLM_BASE_URL@@,
        apiKey: "${LLM_API_KEY}",
        api: "openai-completions",
        timeoutSeconds: 300, // local model; long first-token times are normal
        models: [
          {
            id: @@LLM_MODEL@@,
            name: @@LLM_MODEL@@,
            reasoning: false,
            input: @@LLM_INPUT@@,
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            // Must not exceed the server's own context setting (Ollama defaults
            // to 4096; raise it on the server with OLLAMA_CONTEXT_LENGTH).
            contextWindow: @@LLM_CONTEXT_WINDOW@@,
            maxTokens: @@LLM_MAX_TOKENS@@,
          },
        ],
      },
    },
  },

  agents: {
    defaults: {
      // Host path, mounted at the same path in the gateway (sibling sandboxes
      // are created by the host's Docker daemon, which resolves host paths).
      workspace: "/srv/openclaw/workspace",
      model: { primary: @@LLM_PRIMARY@@ },
      // Every session runs its tools in a Docker sandbox: one long-lived
      // container per agent, with the real workspace mounted at /workspace.
      sandbox: {
        mode: "all",
        backend: "docker",
        scope: "agent",
        workspaceAccess: "rw",
        docker: {
          image: "openclaw-sandbox-local:2", // built by sandbox/install.sh
          // Phase 3b: an internal network whose only exit is the Squid proxy
          // (HTTPS to allowlisted package registries). Set "none" to cut it off.
          network: "oc-sbx",
          user: "1000:1000", // matches /srv/openclaw/workspace ownership
          readOnlyRoot: true,
          tmpfs: ["/tmp", "/var/tmp", "/run"],
          memory: "6g",
          memorySwap: "6g",
          cpus: 2,
          pidsLimit: 1024,
          env: {
            LANG: "C.UTF-8",
            HTTPS_PROXY: "http://172.30.20.2:3128",
            https_proxy: "http://172.30.20.2:3128",
            HTTP_PROXY: "http://172.30.20.2:3128",
            http_proxy: "http://172.30.20.2:3128",
            NO_PROXY: "localhost,127.0.0.1",
            no_proxy: "localhost,127.0.0.1",
          },
        },
      },
    },
  },

  tools: {
    // Exec runs only in the sandbox. Do NOT set exec.mode here: in 2026.10.10
    // mode "deny" also blocks exec inside the sandbox. Host (gateway) exec is
    // blocked by the approvals policy instead (config/exec-approvals.json,
    // security=deny), which OpenClaw applies to every non-sandbox exec.
    exec: { host: "sandbox" },
    // No escape hatch out of the sandbox.
    elevated: { enabled: false },
    // Tuned for a heavily quantized local model: show tool schemas directly instead of
    // behind a search step (the default for OpenAI-compatible providers), and
    // drop the progress-card UI tool. The model (125B at IQ2_XS) was spending its turns on
    // tool_search and progress_card instead of the task.
    // toolSearch is set from the context window by scripts/site_settings.py:
    // off (all tool schemas in the prompt, about 35k tokens) at 65536 or more,
    // on (about 15k tokens) below that, where the full set would not fit.
    toolSearch: @@TOOL_SEARCH@@,
    updatePlan: false,
    // Sandboxed sessions only get a default tool allowlist, which omits web
    // tools. These two run on the gateway (which can reach SearXNG and
    // Firecrawl), not in the sandbox, so the sandbox itself stays offline.
    sandbox: { tools: { alsoAllow: ["web_search", "web_fetch"] } },
    web: {
      // Search through the self-hosted SearXNG.
      search: { provider: "searxng", maxResults: 8, timeoutSeconds: 30 },
      // Page fetches go through the self-hosted Firecrawl; the gateway has no
      // direct internet, so a plain fetch would fail.
      fetch: { provider: "firecrawl" },
    },
  },

  // Plugin packages are installed into the state dir by sandbox/install.sh
  // (the gateway itself has no internet); this config only enables them.
  plugins: {
    // Phase 6: load only these. Without an allowlist 2026.10.10 enables ~40
    // bundled plugins (browser, computer use, file transfer, cloud model
    // providers...). device-pair is needed for Control UI browser pairing.
    // Tested: an agent turn against the model provider works with only these.
    allow: ["searxng", "firecrawl", "memory-core", "device-pair"],
    entries: {
      searxng: {
        enabled: true,
        config: { webSearch: { baseUrl: @@SEARXNG_URL@@ } },
      },
      firecrawl: {
        enabled: true,
        config: {
          webSearch: { baseUrl: @@FIRECRAWL_URL@@, apiKey: "${FIRECRAWL_API_KEY}" },
          webFetch: { baseUrl: @@FIRECRAWL_URL@@, apiKey: "${FIRECRAWL_API_KEY}" },
        },
      },
    },
  },
}
