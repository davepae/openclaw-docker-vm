# Copied to compose/.env by compose/install.sh. Never commit .env.

# OpenClaw release to run. install.sh pulls it and writes the exact digest
# into OPENCLAW_IMAGE below, so the gateway runs that digest until you change this.
OPENCLAW_VERSION=2026.10.10
OPENCLAW_IMAGE=

# Generated by install.sh (openssl rand -hex 32). Paste it into the Control UI.
OPENCLAW_GATEWAY_TOKEN=

# Strata API key on llm.paelab.com. install.sh prompts for it.
STRATA_API_KEY=

# Group that owns /var/run/docker.sock on the VM. Filled in by install.sh.
DOCKER_GID=

TZ=America/Los_Angeles
