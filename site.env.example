# Site settings. ./configure.sh writes site.env for you, with each answer
# checked; this file shows the format for setting it up by hand instead
# (copy to site.env, chmod 600). Values in single quotes; no single quotes
# inside a value. Check a hand-written file with:
#   python3 scripts/site_settings.py check
SITE_VERSION='1'

# Only OpenAI-compatible servers are supported so far.
MODEL_PROVIDER='openai-compatible'

# Base URL of the OpenAI-compatible API, usually ending in /v1. Must be a LAN
# address the VM can reach (not localhost, not this VM). Examples:
#   Ollama     http://192.168.1.20:11434/v1  (set OLLAMA_HOST=0.0.0.0 on the server)
#   LM Studio  http://192.168.1.20:1234/v1   (serve on the local network)
LLM_BASE_URL='http://192.168.1.20:11434/v1'

# Exactly as the server lists it under /v1/models, e.g. 'qwen3:32b' (Ollama)
# or 'qwen/qwen3.5-9b' (LM Studio).
LLM_MODEL='qwen3:32b'

# 'none' if the server has no authentication (Ollama ignores the key; LM Studio
# needs its API token only when authentication is enabled).
LLM_API_KEY='none'

# Must not exceed the server's own context setting. At least 32768; 65536 or
# more recommended (at 65536+ OpenClaw puts every tool directly in the prompt,
# which helps heavily quantized models). Ollama defaults to 4096; raise it on
# the server with OLLAMA_CONTEXT_LENGTH.
LLM_CONTEXT_WINDOW='65536'
LLM_MAX_TOKENS='8192'

# 'yes' only if the model accepts images.
LLM_IMAGE_INPUT='no'

# Self-hosted web tools. Plain http:// for Firecrawl must be a private address.
SEARXNG_URL='http://192.168.1.30:8080'
FIRECRAWL_URL='http://192.168.1.30:3002'

# DNS server(s) the VM itself uses (see: resolvectl status). The gateway may
# query only these. Several are separated by spaces.
DNS_SERVERS='192.168.1.1'

# The machine you administer the VM from; SSH is allowed only from here.
# A single address, or a subnet no wider than /16.
ADMIN_IP='192.168.1.10'
